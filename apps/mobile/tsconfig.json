{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "capacitor.config.ts",
    "../../packages/shared/src",
    "../../packages/core/src",
    "../../packages/ui/src",
    // Only the platform-neutral + mobile-specific files from packages/db —
    // NOT electronDriver.ts/secretCrypto.ts, which use Node built-ins
    // (node:fs, node:crypto, Buffer) that don't exist in a WebView and would
    // otherwise fail typecheck here even though nothing in this app ever
    // imports them (tsconfig's "include" is a typecheck scope, unrelated to
    // what Vite actually bundles, but still worth keeping accurate).
    "../../packages/db/src/DataStore.ts",
    "../../packages/db/src/schema.ts",
    "../../packages/db/src/capacitorDriver.ts",
    "../../packages/db/src/secretCryptoWeb.ts",
    "../../packages/db/src/index.ts"
  ]
}
