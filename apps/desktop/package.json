{
  "name": "@life-manager/desktop",
  "productName": "PakCyberbot Life Manager",
  "version": "1.0.0",
  "description": "A local-first personal life management app — goals, calendar, savings, a book/video library, and more.",
  "author": "PakCyberbot",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@life-manager/core": "*",
    "@life-manager/db": "*",
    "@life-manager/shared": "*",
    "@life-manager/ui": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.pakcyberbot.lifemanager",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../../framework.md",
        "to": "framework.md"
      },
      {
        "from": "resources/icon.ico",
        "to": "resources/icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PakCyberbot-Life-Manager-Setup-${version}.${ext}"
    }
  }
}
